{
  "Lua.diagnostics.globals": [
    "Events",
    "getGameTime",
    "getCore",
    "getClimateManager",
    "forceSnowCheck",
    "ZombRand",
    "writeLog",
    "getPlayer",
    "ProceduralDistributions"
  ],
  "Lua.workspace.library": ["${addons}/umbrella-unstable/module/library"],
  "Lua.runtime.version": "Lua 5.1",
  "Lua.runtime.path": ["?.lua", "?/init.lua", "server/?.lua"],
  "Lua.completion.requireSeparator": "/",
  "Lua.workspace.preloadFileSize": 800,
  "Lua.runtime.builtin": {
    "debug": "disable",
    "io": "disable",
    "package": "disable"
  },
  "Lua.workspace.checkThirdParty": false,
  "[plaintext]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "pzSyntaxExtension.searchDirectories": [
    "C:/Program Files (x86)/Steam/steamapps/common/ProjectZomboid/media/scripts"
  ],
  "json.schemaDownload.trustedDomains": {
    "https://raw.githubusercontent.com/SirDoggyJvla/pz-translation-data": true
  },
  "json.schemas": [
    {
      "fileMatch": [
        "**/media/lua/shared/Translate/*/Moveables.json"
      ],
      "url": "https://raw.githubusercontent.com/SirDoggyJvla/pz-translation-data/refs/heads/main/PZ_Translation_Schemas/Moveables.schema.json",
      "name": "PZ Moveables translation schema"
    }
  ]
}
